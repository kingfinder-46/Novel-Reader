{
    "manifest_version": 3,
    "name": "Web Novel Voice Reader Pro",
    "version": "2.0",
    "description": "Smart dark-mode reader with position saving, highlighting, auto-play, and sleep timer.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}